{% comment %}
  FAQ Accordion Section
{% endcomment %}

<section
  class="faq-section"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --divider-color: {{ section.settings.divider_color }};
  "
>
  <div class="faq-container">

    {% if section.settings.eyebrow != blank %}
      <div class="faq-eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="faq-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item">
          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon">+</span>
          </button>

          <div class="faq-answer">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const items = document.querySelectorAll('.faq-item');

  items.forEach(item => {
    const button = item.querySelector('.faq-question');
    const answer = item.querySelector('.faq-answer');
    const icon = item.querySelector('.faq-icon');

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      items.forEach(i => {
        i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        i.querySelector('.faq-answer').style.maxHeight = null;
        i.querySelector('.faq-icon').textContent = '+';
      });

      if (!isOpen) {
        button.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        icon.textContent = '×';
      }
    });
  });
});
</script>

<style>
.faq-section {
  background: var(--bg-color);
  padding: 80px 20px;
}

.faq-container {
  max-width: 900px;
  margin: 0 auto;
}

.faq-eyebrow {
  text-align: center;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 10px;
  color: var(--text-color);
  opacity: 0.6;
}

.faq-heading {
  text-align: center;
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 600;
  color: var(--heading-color);
  margin-bottom: 48px;
}

.faq-list {
  border-top: 1px solid var(--divider-color);
}

.faq-item {
  border-bottom: 1px solid var(--divider-color);
}

.faq-question {
  width: 100%;
  background: none;
  border: none;
  padding: 22px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 15px;
  font-weight: 500;
  color: var(--heading-color);
  cursor: pointer;
  text-align: left;
}

.faq-icon {
  font-size: 20px;
  line-height: 1;
  margin-left: 20px;
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-color);
  padding-right: 40px;
}

.faq-answer p {
  margin-bottom: 16px;
}

.faq-question[aria-expanded="true"] {
  padding-bottom: 12px;
}

/* Mobile */
@media (max-width: 600px) {
  .faq-section {
    padding: 56px 16px;
  }

  .faq-answer {
    padding-right: 20px;
  }
}
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top label",
      "default": "#ALL THE HELP YOU NEED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We know you are curious!"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdf7ee"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e5e7eb"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your products safe and tested?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Absolutely! All our products undergo rigorous third-party testing for quality, purity, and safety. We follow strict manufacturing standards and source only premium, certified ingredients.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ – Help Section",
      "blocks": [
        { "type": "faq" },
        {
          "type": "faq",
          "settings": {
            "question": "What is your return and refund policy?",
            "answer": "<p>We offer a 7-day money-back guarantee. If you're not satisfied, contact our support team for a full refund.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I track my order?",
            "answer": "<p>Yes! Once your order ships, you'll receive a tracking link via email and SMS.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}