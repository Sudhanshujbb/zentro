{% comment %}
  Relaxation Collection Section
{% endcomment %}

<section class="relax-collection" style="
  --bg: {{ section.settings.bg_color }};
  --text: {{ section.settings.text_color }};
  --card-radius: {{ section.settings.card_radius }}px;
  --accent: {{ section.settings.accent_color }};
">
  <div class="relax-container">

    {% if section.settings.eyebrow != blank %}
      <div class="relax-eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="relax-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="relax-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_limit %}
        {% assign compare = product.compare_at_price %}
        {% assign price = product.price %}
        {% if compare > price %}
          {% assign discount = compare | minus: price | times: 100 | divided_by: compare %}
        {% endif %}

        <a href="{{ product.url }}" class="relax-card">
          <div class="relax-image-wrapper">
            {% if discount %}
              <span class="relax-badge">
                {{ discount | round }}% OFF
              </span>
            {% endif %}

            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          </div>

          <div class="relax-card-content">
            <h3 class="relax-title">{{ product.title }}</h3>

            {% if product.metafields.reviews.rating.value %}
              <div class="relax-rating">
                {% assign rating = product.metafields.reviews.rating.value %}
                {% for i in (1..5) %}
                  {% if i <= rating %}
                    ★
                  {% else %}
                    ☆
                  {% endif %}
                {% endfor %}
                <span>{{ rating }}</span>
              </div>
            {% endif %}
            <div class="relax-wrapper">
            <div class="relax-price">
              {% if compare > price %}
                <span class="old-price">{{ compare | money }}</span>
              {% endif %}
              <span class="new-price">{{ price | money }}</span>
              <span class="arrow">{% render 'icon', icon: 'arrow-new' %}</span>
            </div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.relax-collection {
  background: var(--bg);
  padding: 72px 20px;
}

.relax-container {
  max-width: 1200px;
  margin: 0 auto;
}

.relax-eyebrow {
  text-align: center;
  letter-spacing: 0.18em;
  font-size: 12px;
  margin-bottom: 12px;
  color: var(--text);
  opacity: 0.7;
}

.relax-heading {
  text-align: center;
  font-size: clamp(26px, 4vw, 40px);
  font-weight: 600;
  margin-bottom: 48px;
  color: var(--text);
}

.relax-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.relax-card {
  background: #000;
  border-radius: var(--card-radius);
  overflow: hidden;
  text-decoration: none;
  color: #fff;
  position: relative;
  box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  transition: transform 0.3s ease;
}

.relax-card:hover {
  transform: translateY(-6px);
}

.relax-image-wrapper {
  position: relative;
  aspect-ratio: 3 / 4;
}

.relax-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.relax-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  background: #fff;
  color: #000;
  font-size: 11px;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: 999px;
}

.relax-card-content {
  position: absolute;
  inset: auto 0 0 0;
  padding: 20px;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.8),
    rgba(0,0,0,0.3),
    transparent
  );
}

.relax-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 6px;
}

.relax-rating {
  font-size: 14px;
  color: #ffd54f;
  margin-bottom: 10px;
}

.relax-rating span {
  color: #fff;
  margin-left: 6px;
  font-size: 13px;
}

.relax-wrapper{
  border: 1px solid #1A1A1A;
  background: #fff;
  width: fit-content;
  border-radius: 8px;
}

.relax-price {
      background: #eaff6a;
    color: #000;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 8px;
    width: 100%;
    font-weight: 600;
    border: 1px solid #1A1A1A
}

.relax-price:hover{
  transform: translate(-4px, -4px);
  transition: transform 0.2s ease;
}

.old-price {
  text-decoration: line-through;
  opacity: 0.6;
  font-size: 13px;
}

.new-price {
  font-size: 14px;
}

.arrow {
  font-size: 16px;
}

/* Tablet */
@media (max-width: 900px) {
  .relax-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile */
@media (max-width: 600px) {
  .relax-collection {
    padding: 48px 16px;
  }

  .relax-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Relaxation Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top label",
      "default": "#DESIGNED FOR EVERYBODY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover your perfect relaxation match"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#eaff6a"
    }
  ],
  "presets": [
    {
      "name": "Relaxation Products Collection"
    }
  ]
}
{% endschema %}