<style>
  .whats-included {
  border-radius: 20px;
}

.wi-heading {
  text-align: center;
  margin-bottom: 50px;
  font-size: 32px;
  font-weight: 600;
}

.wi-top {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  text-align: center;
  margin-bottom: 60px;
}

.wi-icon-item img {
  height: 60px;
  margin-bottom: 10px;
}

.wi-highlight {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 70px;
}

.wi-highlight-text {
  background: #ff2e2e;
  color: #fff;
  padding: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.wi-highlight-text h3 {
  font-size: 26px;
  margin-bottom: 15px;
}

.wi-highlight-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.wi-bottom {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}

.wi-bottom-item img {
  width: 100%;
  border-radius: 16px;
  margin-bottom: 20px;
}

.wi-bottom-item h4 {
  margin-bottom: 10px;
  font-size: 20px;
}

/* ============================= */
/* RESPONSIVE */
/* ============================= */

@media (max-width: 1024px) {
  .wi-top {
    grid-template-columns: repeat(2, 1fr);
  }

  .wi-bottom {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {

  #shopify-section-{{ section.id }} .whats-included {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

  .wi-heading {
    font-size: 24px;
  }

  .wi-top {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .wi-highlight {
    grid-template-columns: 1fr;
  }

  .wi-highlight-text {
    padding: 30px;
  }

  .wi-bottom {
    grid-template-columns: 1fr;
  }
}
</style>
<section 
  class="whats-included"
  style="
    background: linear-gradient(
      {{ section.settings.gradient_angle }}deg,
      {{ section.settings.gradient_color_1 }},
      {{ section.settings.gradient_color_2 }}
    );
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="wi-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <!-- TOP ICON FEATURES -->
    <div class="wi-top">
      {% for block in section.blocks %}
        {% if block.type == 'icon_feature' %}
          <div class="wi-icon-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | image_url: width: 120 }}" alt="">
            {% endif %}
            <p>{{ block.settings.title }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- HIGHLIGHT BLOCK -->
    <div class="wi-highlight">
      <div class="wi-highlight-text">
        <h3>{{ section.settings.highlight_title }}</h3>
        <p>{{ section.settings.highlight_text }}</p>
      </div>

      <div class="wi-highlight-image">
        {% if section.settings.highlight_image %}
          <img src="{{ section.settings.highlight_image | image_url: width: 900 }}" alt="">
        {% endif %}
      </div>
    </div>

    <!-- BOTTOM FEATURES -->
    <div class="wi-bottom">
      {% for block in section.blocks %}
        {% if block.type == 'bottom_feature' %}
          <div class="wi-bottom-item" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="">
            {% endif %}
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "What's Included Pro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What's Included"
    },

    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient Color 1",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color 2",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient Angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 180
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 40
    },

    {
      "type": "text",
      "id": "highlight_title",
      "label": "Highlight Title",
      "default": "Intelligent Chip"
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Highlight Description"
    },
    {
      "type": "image_picker",
      "id": "highlight_image",
      "label": "Highlight Image"
    }
  ],

  "blocks": [
    {
      "type": "icon_feature",
      "name": "Top Icon Feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    },
    {
      "type": "bottom_feature",
      "name": "Bottom Feature",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "What's Included Pro"
    }
  ]
}
{% endschema %}