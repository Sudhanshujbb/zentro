<div class="slider-container">
  <div class="slider-wrapper">
    {% assign first = true %}
    {% for block in section.blocks %}
      <div class="slide">
        {% if block.type == 'video' %}
          <a href="{{block.settings.video2_link}}" >
          <video class="slide-image desktop" src="{{ block.settings.video_url.sources[1].url }}" controls autoplay muted loop
          onmouseover="this.setAttribute('controls', 'true')"
          onmouseout="this.removeAttribute('controls')"></video>
          <video class="slide-image mobile" src="{{ block.settings.video_mobile_url.sources[1].url }}" controls autoplay muted loop
          onmouseover="this.setAttribute('controls', 'true')"
          onmouseout="this.removeAttribute('controls')"></video>
          </a>
        {% elsif block.settings.image %}
          <a href="{{block.settings.image_link}}" >
          <img class="slide-video  desktop" src="{{ block.settings.image | img_url: 'master' }}" alt="Slide Image" 
        {% if first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}>
          
          <img class="slide-video mobile" src="{{ block.settings.mobile_image | img_url: 'master' }}" alt="Slide Image"
        {% if first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}>
          </a>
        {% endif %}
        {% assign first = false %}
      </div>
    {% endfor %}
  </div>

  <div class="slider-dots">
    {% for block in section.blocks %}
      <span class="dot" data-index="{{ forloop.index0 }}"></span>
    {% endfor %}
  </div>

  <button class="prev">&lt;</button>
  <button class="next">&gt;</button>
</div>

<style>
  .slider-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .slider-wrapper {
    display: flex;
    transition: transform 0.6s ease;
  }
  .slide {
    min-width: 100%;
    transition: transform 0.6s ease;
  }
  .slide img, .slide video {
    width: 100%;
  }
  .slider-dots {
    position: relative;
    text-align: center;
    margin-top: -22px;
    z-index: 10000;
  }
  .dot {
    height: 6px;
    width: 6px;
    margin: 5px;
    background-color: #C3C8CB;
    border-radius: 50%;
    display: inline-block;
    cursor: pointer;
  }
  .dot.active {
    height: 8px;
    width: 8px;
    background-color: #FFFFFF;
  }
  .prev, .next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
    display: none;
  }
  .prev { left: 10px; }
  .next { right: 10px; }

  .slide-image,
.slide-video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

  .desktop {
  display: block;
}

.mobile {
  display: none;
}

@media (max-width: 768px) {
  .desktop {
    display: none;
  }

  .mobile {
    display: block;
  }
  }

</style>
<script>
document.addEventListener("DOMContentLoaded", function() {
    const sliderWrapper = document.querySelector('.slider-wrapper');
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.querySelector('.prev');
    const nextBtn = document.querySelector('.next');

    let index = 0;
    let startX = 0, currentX = 0;
    let isDragging = false;
    let moved = false;
    let autoSlideInterval = {{ section.settings.autoslide_time | default: 5 }} * 1000;;

    function updateSlider() {
        // sliderWrapper.style.transform = translateX(-${index * 100}%);
        sliderWrapper.style.transform = `translateX(-${index * 100}%)`;

        dots.forEach(dot => dot.classList.remove('active'));
        dots[index].classList.add('active');
    }

    function resetAutoSlide() {
        clearInterval(autoSlideInterval); 
        autoSlideInterval = setInterval(nextSlide, 10000); 
    }

    function nextSlide() {
        index = (index + 1) % slides.length;
        updateSlider();
        resetAutoSlide(); 
    }

    function prevSlide() {
        index = (index - 1 + slides.length) % slides.length;
        updateSlider();
        resetAutoSlide(); 
    }
    
    function autoSlide() {
        autoSlideInterval = setInterval(nextSlide, autoSlideInterval);
    }

    function handleTouchStart(event) {
    startX = event.touches[0].clientX;
    isDragging = false;
    moved = false;
    clearInterval(autoSlideInterval); 
}

    function handleTouchMove(event) {
        currentX = event.touches[0].clientX;
        if (Math.abs(startX - currentX) > 10) { 
            isDragging = true;
            moved = true;
        }
    }

    function handleTouchEnd() {
    if (moved) {
        let diff = startX - currentX;
        if (Math.abs(diff) > 50) {
            if (diff > 0) nextSlide();
            else prevSlide();
        }
    }
    resetAutoSlide(); 
   }

   function handleMouseDown(event) {
    event.preventDefault();
    isDragging = false;
    moved = false;
    startX = event.clientX;
    sliderWrapper.style.cursor = "grabbing";
    clearInterval(autoSlideInterval); 
   }

    function handleMouseMove(event) {
        if (event.buttons === 0) return; 
        currentX = event.clientX;
        if (Math.abs(startX - currentX) > 10) { 
            isDragging = true;
            moved = true;
        }
    }

    function handleMouseUp(event) {
    event.preventDefault();
    sliderWrapper.style.cursor = "grab";
    if (moved) {
        let diff = startX - currentX;
        if (Math.abs(diff) > 50) {
            if (diff > 0) nextSlide();
            else prevSlide();
        }
    }
    resetAutoSlide(); 
   }

    slides.forEach(slide => {
        slide.addEventListener("click", function(event) {
            if (isDragging) {
                event.preventDefault(); 
            } else {
                const anchor = slide.querySelector("a");
                if (anchor) {
                    window.location.href = anchor.href;
                }
            }
        });
    });

    dots.forEach(dot => {
        dot.addEventListener('click', function() {
            index = parseInt(this.dataset.index);
            updateSlider();
            resetAutoSlide(); 
        });
    });

    sliderWrapper.addEventListener('touchstart', handleTouchStart);
    sliderWrapper.addEventListener('touchmove', handleTouchMove);
    sliderWrapper.addEventListener('touchend', handleTouchEnd);

    sliderWrapper.addEventListener('mousedown', handleMouseDown);
    sliderWrapper.addEventListener('mousemove', handleMouseMove);
    sliderWrapper.addEventListener('mouseup', handleMouseUp);
    sliderWrapper.addEventListener('mouseleave', handleMouseUp);

    prevBtn.addEventListener('click', prevSlide);
    nextBtn.addEventListener('click', nextSlide);

    autoSlide(); 
});
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [
    {
      "type": "range",
      "id": "autoslide_time",
      "label": "Auto slide interval (seconds)",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Video Link",
          "info": "Add the URL to redirect when the video is clicked"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video_url",
          "label": "Desktop Video"
        },
        {
          "type": "video",
          "id": "video_mobile_url",
          "label": "Mobile Video"
        },
        {
          "type": "url",
          "id": "video2_link",
          "label": "Video Link",
          "info": "Add the URL to redirect when the video is clicked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider"
    }
  ]
}
{% endschema %}