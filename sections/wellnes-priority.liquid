{% comment %}
  Wellness Priority Section
{% endcomment %}

<section class="wellness-priority" style="
  --bg-color: {{ section.settings.bg_color }};
  --heading-color: {{ section.settings.heading_color }};
  --text-color: {{ section.settings.text_color }};
  --card-bg: {{ section.settings.card_bg }};
  --accent-color: {{ section.settings.accent_color }};
">
  <div class="wellness-container">
    
    {% if section.settings.heading != blank %}
      <h2 class="wellness-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="wellness-description">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div class="wellness-cards">
      {% for block in section.blocks %}
        <div class="wellness-card">
          {% if block.settings.icon != blank %}
            <div class="wellness-icon">
              <img 
                src="{{ block.settings.icon | image_url: width: 80 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="card-title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="card-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.wellness-priority {
  background: var(--bg-color);
  padding: 64px 20px;
}

.wellness-container {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.wellness-heading {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 600;
  color: var(--heading-color);
  margin-bottom: 12px;
}

.wellness-description {
  max-width: 720px;
  margin: 0 auto 48px;
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-color);
}

.wellness-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.wellness-card {
  background: var(--card-bg);
  border-radius: 14px;
  padding: 28px 22px;
  text-align: left;
  box-shadow: 0 10px 30px rgba(0,0,0,0.04);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.wellness-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.08);
}

.wellness-icon {
  width: 42px;
  height: 42px;
  margin-bottom: 16px;
}

.wellness-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--heading-color);
  margin-bottom: 6px;
}

.card-text {
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-color);
}

/* Tablet */
@media (max-width: 900px) {
  .wellness-cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile */
@media (max-width: 600px) {
  .wellness-priority {
    padding: 48px 16px;
  }

  .wellness-cards {
    grid-template-columns: 1fr;
  }

  .wellness-card {
    text-align: left;
  }
}
</style>

{% schema %}
{
  "name": "Wellness Priority",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wellness, Our Priority"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Zentro, we believe comfort and wellness should be accessible to everyone. We carefully curate innovative health and lifestyle products that genuinely improve your daily life."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f8f9f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#475569"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2563eb"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save 20% on cost"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Top-quality products at prices that make wellness affordable for everyone."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Wellness Priority",
      "blocks": [
        { "type": "feature" },
        {
          "type": "feature",
          "settings": {
            "title": "High Perceived Value",
            "text": "Premium quality meets exceptional value. Every rupee you spend delivers real results."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Accurate Deliveries",
            "text": "Your order arrives on time, every time. Reliable shipping with real-time tracking."
          }
        }
      ]
    }
  ]
}
{% endschema %}