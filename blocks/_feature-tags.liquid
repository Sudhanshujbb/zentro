{%- liquid
  assign metafield_namespace = block.settings.metafield_namespace
  assign metafield_key = block.settings.metafield_key
  assign metafield = product.metafields[metafield_namespace][metafield_key]
  
  assign layout = block.settings.layout
  assign spacing = block.settings.spacing
-%}

{% if metafield %}
  <div
    class="feature-tags feature-tags--layout-{{ layout }}"
    style="
      {% if layout == 'grid' %}
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: {{ spacing }}px;
      {% elsif layout == 'flex' %}
        display: flex;
        gap: {{ spacing }}px;
        flex-wrap: wrap;
      {% endif %}
      {% render 'spacing-style', settings: block.settings %}
    "
    {{ block.shopify_attributes }}
  >
    {% for entry in metafield.value %}
      <div class="feature-tags__item">
        {% if entry.feature_icon %}
          <div class="feature-tags__icon">
            {% if entry.feature_icon %}
              <img
                src="{{ entry.feature_icon | image_url: width: 60 }}"
                alt="{{ entry.feature_label }}"
                width="60"
                height="60"
                loading="lazy"
              >
            {% endif %}
          </div>
        {% endif %}

        <div class="feature-tags__content">
          {% if entry.feature_label %}
            <p class="feature-tags__label">{{ entry.feature_label }}</p>
          {% endif %}

          {% if entry.feature_description %}
            <p class="feature-tags__description">{{ entry.feature_description }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <style>
    .feature-tags {
      width: 100%;
    }

    .feature-tags__item {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .feature-tags__icon {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-background-secondary, #f5f5f5);
      border-radius: 8px;
    }

    .feature-tags__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 8px;
    }

    .feature-tags__content {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .feature-tags__label {
      margin: 0;
      font-weight: 600;
      font-size: 14px;
      line-height: 1.4;
      color: var(--color-text, #000);
    }

    .feature-tags__description {
      margin: 0;
      font-size: 13px;
      line-height: 1.5;
      color: var(--color-text-secondary, #666);
    }

    @media (max-width: 768px) {
      .feature-tags__icon {
        width: 50px;
        height: 50px;
      }

      .feature-tags__label {
        font-size: 13px;
      }

      .feature-tags__description {
        font-size: 12px;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Feature Tags",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield Namespace",
      "placeholder": "custom",
      "info": "e.g., 'custom' (the namespace part of your metafield)"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield Key",
      "placeholder": "product_features",
      "info": "e.g., 'product_features' (the key of your metafield)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Type",
      "options": [
        {
          "value": "flex",
          "label": "Flex (Horizontal)"
        },
        {
          "value": "grid",
          "label": "Grid (Responsive)"
        }
      ],
      "default": "flex"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Feature Tags"
    }
  ]
}
{% endschema %}
